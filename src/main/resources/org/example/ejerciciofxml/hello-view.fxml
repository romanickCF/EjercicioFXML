<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<BorderPane prefHeight="470.0" prefWidth="358.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ejerciciofxml.HelloController">
   <center>
      <VBox alignment="CENTER" prefHeight="306.0" prefWidth="341.0" spacing="20.0">
          <padding>
              <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
          </padding>
         <Label text="Introduce un elemento para la lista" />
         <FlowPane alignment="CENTER" columnHalignment="CENTER" hgap="20.0" prefHeight="50.0" prefWidth="233.0">
            <children>
               <TextField fx:id="inputTextLista" onKeyTyped="#activarBoton" />
                <Button fx:id="btnAñadir" onAction="#añadir" text="Añadir" />
            </children>
         </FlowPane>
         <HBox alignment="CENTER" spacing="20.0">
            <children>
               <Button fx:id="btnVaciar" mnemonicParsing="false" onAction="#vaciar" text="Vaciar" />
            </children>
         </HBox>
         <ListView fx:id="lista" prefHeight="146.0" prefWidth="200.0">
            <VBox.margin>
               <Insets />
            </VBox.margin>
         </ListView>
      
          <Button fx:id="btnCerrar" onAction="#cerrar" text="Cerrar aplicacion" />
      
      </VBox>
   </center>
   <bottom>
      <Label text="Creado por Romanick Raga" BorderPane.alignment="CENTER" />
   </bottom>
</BorderPane>
